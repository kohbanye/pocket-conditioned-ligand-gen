# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# uv
# keep uv.lock tracked

# Data, weights, outputs (large / machine-local) ------------------------------
# Model weights are symlinked/copied in from elsewhere, never committed.
/weights/
# Benchmark input structures (downloaded eval sets, extracted complexes).
# No trailing slash: `data` here is a SYMLINK to the eval-set directory, and
# `/data/` matches only real directories, so the symlink showed up as an
# untracked file. Committing a symlink like that is how a checkout later
# turns it self-referential and eats the directory it points at.
/data
# Reconstruction outputs (PDBs, intermediate tensors).
/outputs/
# Aggregated result tables are small enough to keep; ignore only bulky dumps.

# Notebook render artifacts
notebooks/*.html
notebooks/__marimo__/

# Misc
*.log
.DS_Store

# FoldToken dedicated uv venv (CUDA-specific, machine-local)
/.venv-foldtoken/

# SGE/TSUBAME job stdout/stderr (name.e<jobid> / name.o<jobid>[.<taskid>])
*.e[0-9]*
*.o[0-9]*
logs_*.txt
